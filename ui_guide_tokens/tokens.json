{
  "$schema": "doosolution design tokens — generated from design-guide.md",
  "brand": {
    "indigo": "#5B5FEE",
    "indigoHover": "#4A4DD6",
    "indigoStrong": "#3D3FB8",
    "violet": "#8B5CF6",
    "cyan": "#22D3EE",
    "lime": "#B6FF3B",
    "gradient": "linear-gradient(135deg, #5B5FEE 0%, #8B5CF6 55%, #22D3EE 100%)"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "lg": "8px",
    "full": "999px"
  },
  "color": {
    "light": {
      "surface0": "#FFFFFF",
      "surface1": "#F7F7FA",
      "surface2": "#EEEEF3",
      "surfaceElevated": "#FFFFFF",
      "borderSubtle": "#E3E3EA",
      "borderStrong": "#C7C7D1",
      "textPrimary": "#14141A",
      "textSecondary": "#5C5C6B",
      "textMuted": "#8B8B98",
      "textDisabled": "rgba(20,20,26,0.38)",
      "overlay": "rgba(10,10,14,0.4)",
      "focusRing": "#5B5FEE",
      "selectionBg": "#B6FF3B",
      "success": "#1F9D5C",
      "warning": "#B57A0A",
      "danger": "#D6303B",
      "info": "#1D6FC7"
    },
    "dark": {
      "surface0": "#0B0B10",
      "surface1": "#131318",
      "surface2": "#1C1C24",
      "surfaceElevated": "#20202B",
      "borderSubtle": "#2A2A34",
      "borderStrong": "#3A3A46",
      "textPrimary": "#F5F5F7",
      "textSecondary": "#A0A0AE",
      "textMuted": "#6B6B7A",
      "textDisabled": "rgba(245,245,247,0.38)",
      "overlay": "rgba(6,6,10,0.6)",
      "focusRing": "#5B5FEE",
      "selectionBg": "#B6FF3B",
      "success": "#2FD180",
      "warning": "#F5B942",
      "danger": "#F14F5A",
      "info": "#4EA1FF"
    }
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(20,20,26,0.06)",
      "md": "0 4px 16px rgba(20,20,26,0.08)",
      "lg": "0 12px 32px rgba(20,20,26,0.12)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0,0,0,0.3)",
      "md": "0 4px 20px rgba(0,0,0,0.4)",
      "lg": "0 16px 40px rgba(0,0,0,0.5)"
    }
  },
  "typography": {
    "fontSans": "'Pretendard Var', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Malgun Gothic', sans-serif",
    "fontMono": "'JetBrains Mono', ui-monospace, Consolas, monospace",
    "scale": {
      "display": { "size": "56px", "line": 1.1, "weight": 700 },
      "h1": { "size": "40px", "line": 1.15, "weight": 700 },
      "h2": { "size": "30px", "line": 1.2, "weight": 600 },
      "h3": { "size": "22px", "line": 1.3, "weight": 600 },
      "bodyLg": { "size": "18px", "line": 1.6, "weight": 400 },
      "body": { "size": "16px", "line": 1.6, "weight": 400 },
      "sm": { "size": "14px", "line": 1.5, "weight": 400 },
      "xs": { "size": "12px", "line": 1.4, "weight": 500 }
    }
  },
  "spacing": {
    "4": "4px", "8": "8px", "12": "12px", "16": "16px", "24": "24px",
    "32": "32px", "48": "48px", "64": "64px", "96": "96px", "128": "128px"
  },
  "motion": {
    "easeStandard": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durationMicro": "180ms",
    "durationLayout": "300ms"
  },
  "control": {
    "height": { "xs": "28px", "sm": "35px", "md": "40px", "lg": "48px" },
    "paddingXInput": { "xs": "8px", "sm": "10px", "md": "12px", "lg": "16px" },
    "paddingXButton": { "xs": "10px", "sm": "14px", "md": "18px", "lg": "24px" }
  },
  "icon": { "sm": "16px", "md": "20px", "lg": "24px" },
  "zIndex": {
    "dropdown": 100,
    "sticky": 200,
    "tooltip": 300,
    "drawer": 400,
    "modal": 500,
    "toast": 600
  },
  "breakpoints": {
    "mobile": 0,
    "tablet": 640,
    "desktop": 1024,
    "wide": 1440
  }
}
