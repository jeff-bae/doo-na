# --- 서버 ---
PORT=3000
HOST=0.0.0.0
DB_PATH=data/doona.db

# --- Ollama ---
# --- LLM 서버 ---
# ollama (기본) | openai (OpenAI 호환: vLLM, llama.cpp server, LM Studio 등)
LLM_KIND=ollama
LLM_URL=http://127.0.0.1:8001
# LLM_API_KEY=
# openai 방식에서 top_k·repetition_penalty 도 보냄 (OpenAI 정품 API 처럼 거부하는 서버면 false)
# LLM_EXTRA_SAMPLING=true
# 캐릭터별로 다른 서버 쓰기 — <LIVELY|SHY|CAREFUL>_LLM / _URL / _API_KEY (예: 신중만 GPU 서버의 vLLM)
# CAREFUL_LLM=openai
# CAREFUL_URL=http://gpu-server:8000
# CAREFUL_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
# 도커에서 쓸 기본 LLM 주소 (compose 가 LLM_URL 로 넘김)
# DOCKER_LLM_URL=http://gpu-server:8000
# 대화 상대(캐릭터)별 모델 — 🌞 활발 / 🌙 소심 / 🦉 신중
LIVELY_MODEL=qwen2.5-coder:1.5b
SHY_MODEL=qwen2.5-coder:7b
CAREFUL_MODEL=qwen2.5-coder:14b
# 새 대화의 기본 대화 상대 (lively | shy | careful)
DEFAULT_PERSONA=careful
# 큰 모델(7B/14B)은 메모리 때문에 하나씩만 올림 — 교체를 기다리는 최대 시간(초)
GATE_WAIT=300
NUM_CTX=8192
RESPONSE_RESERVE=2048
# 코드/SQL 답변은 낮을수록 일관됨 (대화 위주면 0.7)
TEMPERATURE=0.3
# 답변 최대 길이(토큰) — 작은 모델의 무한 반복 방지
MAX_TOKENS=2048
# 반복 억제 (Qwen 권장값)
REPEAT_PENALTY=1.05
TOP_P=0.8
TOP_K=20
# 🦉 신중(14B)의 메모리 유지 시간 (활발·소심은 30분)
OLLAMA_KEEP_ALIVE=24h
# 첫 글자까지 대기 한도(초) — 14B는 앞 사람 답변을 기다리는 시간까지 포함
FIRST_TOKEN_TIMEOUT=300
IDLE_TIMEOUT=60
# SYSTEM_PROMPT=...

# --- 인증 ---
SESSION_DAYS=30
# 첫 실행 시 사용자가 없으면 이 계정으로 관리자 생성
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# --- 도구 (doona-tools, MCP) ---
# doona ↔ doona-tools 사이 인증 토큰 (아무 긴 문자열)
TOOLS_TOKEN=
# 도구 실행 대기 한도(초)
TOOL_TIMEOUT=20

# 사용자당 분당 질문 수
MESSAGES_PER_MINUTE=15

# --- 공개 접속 (Cloudflare Tunnel) ---
# Cloudflare Zero Trust → Networks → Tunnels 에서 발급한 토큰
# CLOUDFLARE_TUNNEL_TOKEN=
# 토큰을 넣은 뒤 아래 주석을 풀면 docker compose up 시 터널도 함께 실행
# COMPOSE_PROFILES=tunnel

# 웹을 다른 출처에서 띄울 때만 필요 (Tauri 출처는 자동 허용)
# CORS_ORIGINS=http://localhost:5173
